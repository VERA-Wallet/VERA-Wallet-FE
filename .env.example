# BE 연동(ON) 모드로 켜는 유일한 스위치.
#
# 비워 두면 OFF(로컬 mock) 모드다 — FE Route Handler와 인메모리 저장소로 전부 동작한다.
# 값을 넣으면 auth 5경로·/api/events(+하위)·/api/anchor-proof가 `proxy.ts`를 통해 BE로 전달된다.
# `/api/tax/*`·`/api/rulesets`는 ON 모드에서도 FE가 계속 처리한다(FE 세금 엔진이 BE보다 충실도가 높다).
#
# 모드는 요청 시점에 결정되지만 프로세스 env이므로 값을 바꾸면 FE 재시작이 필요하다. 자동 failover는 없다.
VERAWALLET_BACKEND_ORIGIN=http://localhost:3200
# FE mock 모드 강제 스위치.
#
# true면 VERAWALLET_BACKEND_ORIGIN이 설정돼 있어도 FE mock API(Route Handler + 인메모리 저장소)를 쓴다.
# BE의 MOCK_MODE와 대칭.
# 비워 두면 URL 유무가 모드를 정한다.
VERAWALLET_MOCK_MODE=

# SIWE challenge의 domain/uri 출처.
# OFF 모드에서만 쓰인다 — ON 모드에서는 BE의 SIWE_TRUSTED_ORIGIN이 유일한 계약이며 이 값은 무시된다.
# ON 모드에서는 BE가 만든 challenge를 그대로 서명하므로 이 값이 달라도 challenge_mismatch가 나지는 않는다.
# 다만 사용자가 보는 주소와 서명 메시지의 주소가 어긋나면 SIWE의 origin 보장이 무의미해지므로 BE 설정과 맞춰 둔다.
SIWE_TRUSTED_ORIGIN=http://localhost:3100

# OmniOne CX 표준인증창(모바일신분증 로그인 모달) 자산/설정 호스트 — 해커톤 가이드북 p.19-25.
# 비워 두면 기존 mock QR 프레젠테이션이 유지된다. 값을 넣으면 로그인 버튼이 CX 인증창을 열고,
# 성공 콜백의 token을 /api/auth/did/present의 cxToken으로 전달한다(BE MOCK_MODE=false에서 실검증).
# NEXT_PUBLIC_이므로 빌드 시점에 인라인된다 — 변경 시 next dev/build 재시작 필요.
# 예: NEXT_PUBLIC_OMNIONE_CX_AUTH_URL=https://cx.raonsecure.co.kr:17543/ent/esign
NEXT_PUBLIC_OMNIONE_CX_AUTH_URL=

# CX "했다 치고" 스위치. true면 실제 표준인증창(raonsecure 모달)을 열지 않고 고정 mock 토큰으로
# present까지 진행한다 — 폰(모바일신분증 앱)·네트워크 없이 CX 버튼 흐름을 시연/로컬 테스트할 때 쓴다.
# AUTH_URL이 비어 있어도 CX 버튼이 노출되며, 채워져 있어도 이 값이 true면 실모달 대신 mock이 우선한다.
# FE mock present 라우트는 cxToken을 검증하지 않으므로(country만 확인) 어떤 토큰이든 통과한다.
# 서버 VERAWALLET_MOCK_MODE와는 별개다(그건 NEXT_PUBLIC_이 아니라 클라가 못 본다). 변경 시 재시작 필요.
NEXT_PUBLIC_OMNIONE_CX_MOCK=

# 세금 계산의 환율 소스. 룰셋 통화가 이벤트 통화(BE는 KRW)와 다를 때 거래일 환율로 환산한다.
# 비워 두면 Frankfurter(ECB 기준환율, EUR 교차환율)를 거래일 기준으로 조회한다 — 운영 기본값.
# `fixed`면 lib/adapters/fx/fixed-fx-rate.ts의 고정 환율표를 쓴다. 결정적 테스트·CI 전용이며
# 통합·e2e 하네스가 스스로 `fixed`로 켠다. 운영에서 켜면 취득·양도 시점의 환율 차이가 사라져 손익이 틀어진다.
# 환율 소스 장애 시 /api/tax/*는 502 `fx_unavailable`을 돌려준다.
VERAWALLET_FX_SOURCE=

# dev 서버를 원격 브라우저(공인 IP·터널 호스트)로 열 때 허용할 호스트명. 쉼표 구분, 포트 없음.
# Next가 HMR 같은 dev 전용 엔드포인트의 교차 출처 요청을 막으므로 next.config의 allowedDevOrigins로 전달된다.
# 비워 두면 기존처럼 localhost 전용. next dev에만 영향이 있고 build/start는 무시한다.
# 예: VERAWALLET_DEV_ALLOWED_ORIGINS=abc123.ngrok-free.app,192.168.0.10
VERAWALLET_DEV_ALLOWED_ORIGINS=
